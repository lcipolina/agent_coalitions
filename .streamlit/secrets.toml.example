# Streamlit Community Cloud secrets template.
#
# Local development: ignore this file. Use the project root .env instead;
# pydantic-settings loads it automatically.
#
# Streamlit Cloud deploy:
#   1. Do NOT commit secrets.toml — only this *.example* template.
#   2. In the Streamlit Cloud dashboard, open your app → Settings → Secrets.
#   3. Paste the contents of secrets.toml (with real values) into that panel.
#   4. app.py copies these into os.environ before src.core.config is loaded,
#      so the same pydantic Settings class works in both environments.
#
# Only MONGODB_URI is required for the published demo (USE_MOCK_LLM is
# forced on in app.py and the replay cache covers every prompt). The
# OpenAI keys are here for completeness if you re-enable real-LLM mode.

MONGODB_URI = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB  = "agent_coalitions"

# Optional — only needed if you flip USE_MOCK_LLM to "false" in app.py.
OPENAI_API_KEY            = ""
OPENAI_BASE_URL           = ""
OPENAI_EMBEDDING_API_KEY  = ""
OPENAI_EMBEDDING_MODEL    = "text-embedding-3-small"
OPENAI_CHAT_MODEL         = "gpt-4o-mini"

SEED = "42"
