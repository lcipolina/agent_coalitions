# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agent_coalitions

# ─── LLM provider ────────────────────────────────────────────────
# Pipeline-wide kill switch. When true, no real LLM calls are made
# (src/llm/mock.py serves both chat and embeddings). Default for dev.
USE_MOCK_LLM=true

# ─── Real-LLM mode (USE_MOCK_LLM=false) ──────────────────────────
# Option A) OpenAI direct: leave OPENAI_BASE_URL empty.
#   OPENAI_API_KEY=sk-...
#
# Option B) OpenRouter for chat (cheaper, many models):
#   OPENAI_API_KEY=sk-or-...                             # OpenRouter key
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_CHAT_MODEL=openai/gpt-4o-mini                 # OpenRouter id
#   OPENAI_EMBEDDING_API_KEY=sk-...                      # real OpenAI key
#                                                        # (OpenRouter does not serve embeddings)
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Pipeline determinism
SEED=42
